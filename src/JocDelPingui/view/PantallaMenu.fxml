<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="JocDelPingui.view.menuView"
    minWidth="600" minHeight="400" prefWidth="1000" prefHeight="700"
    stylesheets="@PantallaMenu.css"
    styleClass="root">

    <center>
        <StackPane fx:id="stackPane" alignment="CENTER">

            <!-- Slider de volumen (arriba derecha) -->
            <VBox StackPane.alignment="TOP_RIGHT" pickOnBounds="false" alignment="TOP_RIGHT" fillWidth="false">
                <StackPane.margin>
                    <Insets top="18" right="18"/>
                </StackPane.margin>
                <HBox styleClass="volume-pill" spacing="8" alignment="CENTER">
                    <Label text="🔊" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    <Slider fx:id="volumeSlider" min="0" max="1" value="0.5"
                            prefWidth="100" styleClass="volume-slider"/>
                </HBox>
            </VBox>

            <!-- Tarjeta de login -->
            <VBox spacing="25" styleClass="card" maxWidth="380" maxHeight="420" StackPane.alignment="CENTER">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <VBox spacing="10">
                    <Label text="Usuario" styleClass="field-label"/>
                    <TextField fx:id="userField" promptText="Usuario..." styleClass="field"/>
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="passField" promptText="Contraseña..." styleClass="field"/>
                </VBox>

                <Region prefHeight="6"/>

                <HBox spacing="10">
                    <Button fx:id="loginButton" text="Login" onAction="#handleLogin"
                            maxWidth="Infinity" styleClass="primary" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="registerButton" text="Registro" onAction="#handleRegister"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Button fx:id="exitButton" text="Salir del Juego" onAction="#handleSalirPrograma"
                        maxWidth="Infinity" styleClass="exit-button"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>