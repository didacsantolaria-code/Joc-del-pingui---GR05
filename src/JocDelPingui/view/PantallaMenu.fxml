<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="JocDelPingui.view.menuView"
    minWidth="600" minHeight="400" prefWidth="1000" prefHeight="700"
    stylesheets="@PantallaMenu.css"
    styleClass="root">



    <center>
        <StackPane fx:id="stackPane" alignment="CENTER">

            <VBox spacing="16" styleClass="card" maxWidth="420" maxHeight="450" StackPane.alignment="CENTER">
                <padding>
                    <Insets top="28" right="28" bottom="28" left="28"/>
                </padding>



                <VBox spacing="10">
                    <Label text="Usuario" styleClass="field-label"/>
                    <TextField fx:id="userField" promptText="Usuario..." styleClass="field"/>
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="passField" promptText="Contraseña..." styleClass="field"/>
                </VBox>

                <Region prefHeight="6"/>

                <HBox spacing="10">
                    <Button fx:id="loginButton" text="Login" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary"/>
                    <Button fx:id="registerButton" text="Registro" onAction="#handleRegister" maxWidth="Infinity"/>
                </HBox>
                
                <Button fx:id="exitButton" text="Salir del Juego" onAction="#handleSalirPrograma" maxWidth="Infinity" style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px; -fx-background-radius: 5px;"/>

                <Label text="Tip: para la demo, puedes entrar con cualquier usuario si aún no hay validación."
                       styleClass="hint" wrapText="true"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>